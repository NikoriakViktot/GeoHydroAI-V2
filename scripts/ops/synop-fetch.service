[Unit]
Description=SYNOP telegrams from ogimet into the lake and its S3 mirror (scripts/ops/synop_fetch.sh)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/ops/synop_fetch.sh
StandardOutput=append:/data/backups/synop_fetch.log
StandardError=append:/data/backups/synop_fetch.log
TimeoutStartSec=45min
Nice=10
